{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "concurrently -k -n mock,next -c yellow,cyan \"npm:mock-api\" \"API_URL=http://localhost:3001 MOCK_API_URL=http://localhost:3001 next dev\"",
    "mock-api": "MOCK_PORT=3001 node e2e/mock-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:vrt": "playwright test",
    "test:vrt:update": "playwright test --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:stories": "node scripts/check-stories.mjs"
  },
  "dependencies": {
    "aframe": "^1.7.1",
    "hls.js": "^1.6.16",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/nextjs-vite": "^10.5.6",
    "@tailwindcss/postcss": "^4",
    "@types/aframe": "^1.2.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-storybook": "^10.5.6",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "storybook": "^10.5.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
