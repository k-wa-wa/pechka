{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/print-dev-qr.mjs && next dev -H 0.0.0.0",
    "dev:mock": "node scripts/print-dev-qr.mjs && concurrently -k -n mock,next -c yellow,cyan \"npm:mock-api\" \"API_URL=http://localhost:3001 MOCK_API_URL=http://localhost:3001 next dev -H 0.0.0.0\"",
    "mock-api": "MOCK_PORT=3001 node e2e/mock-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:vrt": "playwright test",
    "test:vrt:update": "playwright test --update-snapshots=all",
    "test:mutation": "stryker run --since",
    "test:mutation:full": "stryker run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:stories": "node scripts/check-stories.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:stories && npm run check:tests && npm run test"
  },
  "dependencies": {
    "aframe": "^1.7.1",
    "hls.js": "^1.6.16",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/nextjs-vite": "^10.5.6",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/aframe": "^1.2.9",
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-storybook": "^10.5.6",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "qrcode-terminal": "^0.12.0",
    "storybook": "^10.5.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
