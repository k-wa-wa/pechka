FROM golang:1.26 AS builder
WORKDIR /app
COPY batch/etl/go.mod batch/etl/go.sum ./
RUN go mod download
COPY batch/etl/ ./
RUN CGO_ENABLED=0 go build -o pechka-etl .

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN (sed -i -e 's/Components: main/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || sed -i -e 's/main/main universe/' /etc/apt/sources.list) \
    && apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/pechka-etl /usr/local/bin/pechka-etl

ENTRYPOINT ["/usr/local/bin/pechka-etl", "transform"]
