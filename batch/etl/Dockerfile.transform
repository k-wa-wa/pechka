FROM golang:1.26 AS builder
WORKDIR /app
COPY batch/etl/go.mod batch/etl/go.sum ./
RUN go mod download
COPY batch/etl/ ./
RUN CGO_ENABLED=0 go build -o pechka-etl .

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/pechka-etl /usr/local/bin/pechka-etl

ENTRYPOINT ["/usr/local/bin/pechka-etl", "transform"]
