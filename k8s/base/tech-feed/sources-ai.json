{
  "_note": "AI関連ニュース収集ソース。OpenAI, Anthropic, Qwen, NVIDIA 等のAI情報に特化。",
  "primary_domain_patterns": [
    "(?i)github\\.com/[^/]+/[^/]+",
    "(?i)([a-z0-9-]+\\.)?openai\\.com",
    "(?i)([a-z0-9-]+\\.)?anthropic\\.com",
    "(?i)([a-z0-9-]+\\.)?moonshot\\.cn",
    "(?i)qwenlm\\.github\\.io",
    "(?i)([a-z0-9-]+\\.)?nvidia\\.com",
    "(?i)([a-z0-9-]+\\.)?amd\\.com",
    "(?i)([a-z0-9-]+\\.)?intel\\.com",
    "(?i)huggingface\\.co",
    "(?i)arxiv\\.org",
    "(?i)([a-z0-9-]+\\.)?google(blog)?\\.(com|dev)",
    "(?i)research\\.google",
    "(?i)([a-z0-9-]+\\.)?microsoft\\.com"
  ],
  "rss": [
    {
      "name": "Publickey",
      "url": "https://www.publickey1.jp/atom.xml",
      "is_primary": false
    },
    {
      "name": "Zenn Trending",
      "url": "https://zenn.dev/feed",
      "is_primary": false
    },
    {
      "name": "Alibaba Qwen Blog",
      "url": "https://qwenlm.github.io/blog/index.xml",
      "is_primary": true
    },
    {
      "name": "NVIDIA Developer Blog",
      "url": "https://developer.nvidia.com/blog/feed/",
      "is_primary": true
    },
    {
      "name": "NVIDIA Newsroom",
      "url": "https://nvidianews.nvidia.com/releases.xml",
      "is_primary": true
    },
    {
      "name": "AMD Press Releases",
      "url": "https://ir.amd.com/news-events/press-releases/rss",
      "is_primary": true
    },
    {
      "name": "Intel Newsroom",
      "url": "https://newsroom.intel.com/feed",
      "is_primary": true
    },
    {
      "name": "OpenAI News",
      "url": "https://openai.com/news/rss.xml",
      "is_primary": true
    }
  ],
  "hacker_news": {
    "enabled": true,
    "top_n": 60,
    "min_score": 150,
    "is_primary": false
  },
  "github_releases": [
    {
      "repo": "openai/openai-python",
      "is_primary": true
    },
    {
      "repo": "anthropics/anthropic-sdk-python",
      "is_primary": true
    },
    {
      "repo": "QwenLM/Qwen2.5",
      "is_primary": true
    },
    {
      "repo": "MoonshotAI/Kimi-k1.5",
      "is_primary": true
    },
    {
      "repo": "ROCm/ROCm",
      "is_primary": true
    },
    {
      "repo": "intel/intel-graphics-compiler",
      "is_primary": true
    }
  ],
  "html_scrape": [
    {
      "name": "Anthropic News",
      "url": "https://www.anthropic.com/news",
      "is_dynamic": true,
      "is_primary": true,
      "container_selector": "a[href*='/news/']",
      "title_selector": "h3, h2, .title",
      "url_attribute": "href",
      "base_url": "https://www.anthropic.com"
    },
    {
      "name": "Kimi Moonshot News",
      "url": "https://www.moonshot.cn/",
      "is_dynamic": true,
      "is_primary": true,
      "container_selector": "a[href*='news'], a[href*='blog']",
      "title_selector": "h3, .title, span",
      "url_attribute": "href",
      "base_url": "https://www.moonshot.cn"
    }
  ]
}
